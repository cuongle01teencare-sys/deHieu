# Copy → server.env, điền giá trị thực
# ─────────────────────────────────────────────────────────────

# ─── Database ───
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://dehieu:changeme@timescaledb:5432/dehieu

# ─── Redis ───
REDIS_URL=redis://redis:6379/0

# ─── CSGOEmpire auth (phase 1: cookie inject) ───
# Cách lấy:
#   1. Login vào csgoempire.com bằng browser
#   2. F12 → Network → click 1 request tới csgoempire.com/api/v2/...
#   3. Chuột phải → Copy → Copy as cURL
#   4. Trong output cURL, tìm phần: -H 'cookie: XSRF-TOKEN=...; csgo_session=...; ...'
#   5. Copy nguyên chuỗi trong ngoặc (không có `cookie:` prefix), paste vào đây
# LƯU Ý: Cookie thường sống 2 tuần. Khi thấy poller log 401, lấy lại cookie mới.
CSGO_COOKIE_HEADER=

# Optional: nếu sau này backend đổi sang Bearer, set token vào đây (hiện không cần)
CSGO_BEARER_TOKEN=

# ─── Empire device identifier (bắt buộc) ───
# Cách lấy: F12 → Network → click request /api/v2/... → Headers → tìm
#   x-empire-device-identifier: <uuid>
# Cùng UUID này xuất hiện trong query của /api/v2/metadata?uuid=<uuid>
CSGO_DEVICE_ID=

# Từ header x-env-class trong request (thường là "green")
CSGO_ENV_CLASS=green

# TOTP secret (base32, khoảng 16-32 chars) — lấy khi setup 2FA lần đầu
# Nếu account có 2FA → BẮT BUỘC set, poller sẽ compute code 6 số mỗi 30s
# Nếu không có 2FA → để trống
CSGO_TOTP_SECRET=

CSGO_BASE=https://csgoempire.com
CSGO_BRAND_ID=2432911154364948480
SPTPUB_BASE=https://api-h-c7818b61-608.sptpub.com

# ─── Poller (2 loop song song) ───
POLL_LIVE_SECONDS=1.0                # score real-time
POLL_PREMATCH_SECONDS=30.0           # odds/schedule

# ─── API ───
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
