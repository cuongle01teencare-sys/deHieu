# Copy → server.env, điền giá trị thực
# ─────────────────────────────────────────────────────────────

# ─── Database ───
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://dehieu:changeme@timescaledb:5432/dehieu

SPTPUB_BRAND_ID=2432911154364948480
SPTPUB_BASE=https://api-h-c7818b61-608.sptpub.com

# ─── Poller (4 loop song song trong 1 process) ───
#
# LƯU Ý: docker-compose dùng `format: raw` cho env_file — KHÔNG được inline
# comment sau value (VD `POLL_LIVE_SECONDS=1.0 # score` sẽ fail parse).
# Comment ĐỂ TRÊN DÒNG RIÊNG như dưới đây.

# score real-time (giây)
POLL_LIVE_SECONDS=1.0

# odds/schedule (giây)
POLL_PREMATCH_SECONDS=30.0

# market dict + status labels — refresh rất chậm (giây)
POLL_DESCRIPTORS_SECONDS=3600.0

# per-event players + market overrides (giây)
POLL_EVENT_DESCRIPTIONS_SECONDS=300.0

# Flag bật/tắt loop live (default false — chỉ prematch)
POLL_LIVE_ENABLED=false

# Flag bật/tắt loop prematch (default true)
POLL_PREMATCH_ENABLED=true

# ─── Polymarket poller ───

# Interval giữa 2 lần fetch keyset (giây). CDN cache 300s, đừng poll < 30s.
POLY_POLL_INTERVAL_SECONDS=60

# Cửa sổ prematch: chỉ fetch event có startTime trong [NOW, NOW+H giờ]
POLY_WINDOW_HOURS=168

# Số event tối đa 1 lần fetch
POLY_PAGE_LIMIT=100

# Flag bật/tắt polymarket poller
POLY_POLL_ENABLED=true

# ─── Polymarket WebSocket ingestor ───

# Flag bật/tắt polymarket WS (ingest bid/ask realtime từ CLOB)
POLY_WS_ENABLED=true

# ─── Arb detector ───

# Poll interval (giây)
ARB_POLL_INTERVAL_SECONDS=2.0
# Freshness cap (giây) — 300 cover cả prematch; giảm nếu chỉ live
ARB_FRESHNESS_SECONDS=300
ARB_MIN_EDGE_IMPROVEMENT_PCT=0.5
ARB_ENABLED=true
# false ⇒ chỉ detect arb prematch, bỏ mọi match phase='live' (áp dụng cho
# cả sptpub và polymarket vì match_id chung).
ARB_LIVE_ENABLED=true

# ─── Notifications ───

# Discord webhook URL (channel → Integrations → Webhooks → Copy URL).
# Rỗng ⇒ tắt notify. Đừng commit URL thật.
DISCORD_WEBHOOK_URL=

# Chỉ notify arb có edge >= threshold (%). 0 = mọi arb mới.
NOTIFY_MIN_EDGE_PCT=0.0

# ─── API ───
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
