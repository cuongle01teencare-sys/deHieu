[Unit]
Description=Arb Ops NestJS backend
Wants=network-online.target docker.service
Requires=arb-xvfb.service
After=network-online.target docker.service arb-xvfb.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=arbops
Group=arbops
WorkingDirectory=/opt/arb-ops
Environment=NODE_ENV=production
Environment=HTTP_BIND_HOST=127.0.0.1
Environment=WS_BIND_HOST=127.0.0.1
Environment=DISPLAY=:99
Environment=XAUTHORITY=/run/arb-xvfb/Xauthority
Environment=TRADING_EXTERNAL_DISPLAY=1
Environment=PNPM_HOME=/home/arbops/.local/share/pnpm
Environment=PATH=/home/arbops/.local/share/pnpm/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/test -f /opt/arb-ops/.env
ExecStartPre=/usr/bin/test -f /opt/arb-ops/dist/main.js
ExecStart=/home/arbops/.local/share/pnpm/bin/pnpm run start:prod
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
BindReadOnlyPaths=/tmp/.X11-unix /run/arb-xvfb/Xauthority
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
