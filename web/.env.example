# ---------- Backend (NestJS) — chỉ server Next.js đọc, KHÔNG có tiền tố NEXT_PUBLIC
# URL REST của backend (Vercel gọi tới → phải là HTTPS công khai)
BACKEND_URL=https://api.example.com
# URL WebSocket admin mà TRÌNH DUYỆT mở (wss://, cổng ADMIN_WS_PORT qua reverse proxy có TLS).
# Để trống = không dùng stream, web tự thăm dò (polling) REST.
BACKEND_ADMIN_WS_URL=wss://api.example.com/admin-ws

# ---------- Đăng nhập web
# Khóa mã hóa cookie phiên, tối thiểu 32 ký tự ngẫu nhiên (vd: openssl rand -base64 32)
SESSION_SECRET=
# Người dùng web (JSON). passwordHash tạo bằng: pnpm --filter arb-ops-web hash-password '<mật khẩu>'
# apiToken = token trong API_TOKENS của backend → quyền của người này do backend quyết định.
WEB_USERS=[{"username":"thanh","name":"Nguyễn Thành","role":"Administrator","passwordHash":"scrypt$...","apiToken":"..."}]

# ---------- Chế độ dữ liệu mẫu (không cần backend; dùng cho preview/thiết kế)
# true = mọi API trả dữ liệu mẫu, đăng nhập bằng demo / demo nếu WEB_USERS trống.
ARB_MOCK=false
# Nhãn môi trường hiển thị ở sidebar/footer
NEXT_PUBLIC_ENV_LABEL=Production

# ---------- OneSignal Web Push (PWA trên desktop/Android/iOS)
# App ID công khai từ OneSignal > Settings > Keys & IDs. Trống = tắt SDK.
# Không đặt REST API Key ở biến NEXT_PUBLIC_*.
# Chọn Custom Code trong cấu hình Web của OneSignal; Site URL phải khớp origin.
# Sau khi đổi App ID, restart dev server hoặc build/deploy lại web.
NEXT_PUBLIC_ONESIGNAL_APP_ID=
