# ============================================================================
#  nest-de-hieu-v2 — biến môi trường
#  Sao chép thành .env rồi điền giá trị thật. Không commit .env.
# ============================================================================

# ---------------------------------------------------------------- App (HTTP)
# Cổng HTTP của app (API điều khiển + query). Mặc định 3000.
PORT=3000
HTTP_BIND_HOST=0.0.0.0
# Tài liệu API (Swagger UI) tại http://<host>:PORT/docs, JSON tại /docs-json. Đặt false để tắt.
API_DOCS_ENABLED=true

# ---------------------------------------------------------------- PostgreSQL
# Dùng cho bảng team_aliases (Drizzle). Khớp với docker-compose.yml ở thư mục gốc.
# POSTGRES_PASSWORD dùng cho container; DATABASE_URL phải chứa cùng mật khẩu đó.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5432/deHieu

# ---------------------------------------------------------------- Store (Dragonfly / Redis)
# Mật khẩu cho container Dragonfly trong docker-compose.yml (bắt buộc khi chạy compose).
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM
# URL app dùng để kết nối store. Dragonfly nói giao thức Redis nên dùng redis:// như thường.
REDIS_URL=redis://:CHANGE_ME_LONG_RANDOM@127.0.0.1:6379

# ---------------------------------------------------------------- WebSocket chung
# Địa chỉ nghe của cả 3 WebSocket server (3001/3002/3003). Đứng sau reverse proxy TLS cùng máy
# (xem deploy/README.md) → 127.0.0.1 để các cổng này không lộ ra internet.
WS_BIND_HOST=0.0.0.0

# ---------------------------------------------------------------- Kênh publisher (microservice → app)
# App mở WebSocket server ở cổng này cho các node task-runner kết nối vào.
TASK_WS_PORT=3001
# Token dùng chung giữa app và mọi node task-runner (>= 16 ký tự). Tạo: openssl rand -hex 32
TASK_WS_TOKEN=CHANGE_ME_AT_LEAST_16_CHARS
# Frame tối đa từ node (MB). Snapshot / trang danh sách trận có thể lớn.
TASK_WS_MAX_PAYLOAD_MB=64

# ---------------------------------------------------------------- Kênh consumer (app → Discord bot, auto-trade)
CONSUMER_WS_PORT=3002
# Token consumer gửi trong frame hello (>= 16 ký tự). Nên KHÁC TASK_WS_TOKEN và API_TOKENS.
CONSUMER_WS_TOKEN=CHANGE_ME_AT_LEAST_16_CHARS

# ---------------------------------------------------------------- Xác thực + phân quyền API
# Danh sách token: "token:principalId:role1|role2" phân tách bằng dấu phẩy. Rỗng = không ai gọi được API.
# Vai trò mặc định: admin (mọi quyền), manager, staff, viewer (chỉ đọc). Gọi API với header
#   Authorization: Bearer <token>
API_TOKENS=CHANGE_ME_ADMIN_TOKEN:alice:admin,CHANGE_ME_VIEWER_TOKEN:bob:viewer
# (Tùy chọn) Thêm/ghi đè vai trò → quyền bằng JSON, không cần sửa code:
# ROLE_PERMISSIONS={"moderator":["team-aliases:*","arbitrage:read"]}

# ============================================================================
#  Chỉ dành cho microservice task-runner (pnpm start:task-runner)
#  Mỗi tiến trình task-runner cần một NODE_ID riêng; TASK_WS_TOKEN phải trùng với app.
# ============================================================================
TASK_RUNNER_NODE_ID=node-1
# Cùng máy với app: ws://127.0.0.1:3001 · qua internet (sau proxy TLS): wss://api.example.com/task-ws
TASK_RUNNER_APP_URL=ws://127.0.0.1:3001

# Ghi chú: URL/brand của sptpub, tagIds của polymarket, tần suất fetch... KHÔNG nằm ở đây.
# Chúng là tham số của từng publisher, truyền khi tạo qua POST /tasks, ví dụ:
#   { "taskId": "sptpub-live", "kind": "sptpub.live",
#     "runtime": { "type": "worker" },
#     "params": { "baseUrl": "https://api-h-xxxx.sptpub.com", "brandId": "...", "lang": "en",
#                 "intervalMs": 1000 } }

# ---------- Vận hành (admin)
# WebSocket cho dashboard admin (hello bằng token trong API_TOKENS, cần quyền admin:read)
ADMIN_WS_PORT=3003
# Discord webhook nhận cảnh báo sự cố (để trống = chỉ ghi log). Đây là BÍ MẬT, đừng commit.
DISCORD_ALERT_WEBHOOK_URL=
# Số ngày giữ lịch sử chuyển trạng thái odds
ODDS_TRANSITION_RETENTION_DAYS=7
# Số ngày giữ (dọn mỗi ngày, theo lô): lịch sử kèo đã kết thúc / sự cố đã đóng / audit
SIGNAL_HISTORY_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365

# ---------- Dọn dòng kèo
# Xóa sạch room trong Redis lúc khởi động (dòng cũ không còn bảng định tuyến → mồ côi). true | false
RESET_ROOMS_ON_START=true
# Quá giờ bắt đầu + ngần này giờ → coi trận đã xong, gỡ dòng kèo (lý do match_expired)
MATCH_MAX_DURATION_HOURS=8

# NestJS Observe (https://observe.nestjs.com). Để trống = tắt hẳn telemetry.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=nest-de-hieu-v2
